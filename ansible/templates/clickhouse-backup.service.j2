[Unit]
Description=ClickHouse native backup and chain-safe retention
After=clickhouse-stack.service network-online.target
Requires=clickhouse-stack.service

[Service]
Type=oneshot
UMask=0077
ExecStart={{ stack_root }}/venv/bin/python {{ stack_root }}/backup.py {{ stack_root }}/backup.json run
TimeoutStartSec=6h
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ stack_root }}
ProtectHome=true
PrivateTmp=true
