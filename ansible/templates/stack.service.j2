[Unit]
Description=ClickHouse stack Compose project
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ stack_root }}
ExecStart={{ stack_root }}/venv/bin/podman-compose -f {{ stack_root }}/compose.yml up -d
ExecStop={{ stack_root }}/venv/bin/podman-compose -f {{ stack_root }}/compose.yml stop
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
