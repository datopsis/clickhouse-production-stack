[Unit]
Description=Renew short-lived instance-role credentials for native S3 backups
After=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart={{ stack_root }}/venv/bin/python {{ stack_root }}/backup.py {{ stack_root }}/backup.json credentials
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ stack_root }}
ProtectHome=true
PrivateTmp=true
