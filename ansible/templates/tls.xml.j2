  <openSSL>
{% for direction in ['server', 'client'] %}
    <{{ direction }}>
      <certificateFile>/etc/stack/tls.crt</certificateFile>
      <privateKeyFile>/etc/stack/tls.key</privateKeyFile>
      <caConfig>/etc/stack/ca.crt</caConfig>
      <loadDefaultCAFile>false</loadDefaultCAFile>
      <verificationMode>strict</verificationMode>
      <extendedVerification>true</extendedVerification>
      <disableProtocols>sslv2,sslv3,tlsv1,tlsv1_1</disableProtocols>
      <invalidCertificateHandler><name>RejectCertificateHandler</name></invalidCertificateHandler>
    </{{ direction }}>
{% endfor %}
  </openSSL>
